includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src/

    level: 5

    ignoreErrors:
        -
            identifier: nullCoalesce.expr
            path: src/ReverseRelation.php

    excludePaths:
        analyse:
            - src/ReversesRelationships.php
            - src/ShieldsAttributes.php
